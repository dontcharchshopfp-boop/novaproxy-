# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Upstream OpenAI-compatible API
UPSTREAM_BASE_URL=https://provider.example/v1
UPSTREAM_API_KEY=

# Secondary provider: ONLY these fixed chat models are routed here:
# claude-fable-5.1, claude-opus-5, gpt-6-astra, gpt-5.6-sol
STRAX_API=
STRAX_BASE_URL=

# Admin panel
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Optional settings
PORT=3000
ALLOWED_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=30
MAX_BODY_MB=10
